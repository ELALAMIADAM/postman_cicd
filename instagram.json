    {
      "name": "user by letter",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {\r",
              "\tpm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "let body_res = pm.response.json()\r",
              "let users = body_res.data\r",
              "pm.test(\"2 users found\",function(){\r",
              "\tlet index1 = Math.floor(Math.random()*users.length)\r",
              "\tpm.collectionVariables.set(\"user_id_1\",users[index1].id)\r",
              "\r",
              "\tlet index2 = Math.floor(Math.random()*users.length)\r",
              "\twhile(index1===index2) \r",
              "\t\tindex2 = Math.floor(Math.random()*users.length)\r",
              "\tpm.collectionVariables.set(\"user_id_2\",users[index2].id)\r",
              "\r",
              "})\r",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "let randomChar = String.fromCharCode(Math.floor(Math.random() * 26) + 97);\r",
              "pm.collectionVariables.set(\"randomChar\", randomChar);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
