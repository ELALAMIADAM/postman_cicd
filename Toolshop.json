              "});\r",
              "pm.test(\"is the result correct\", function() {\r",
              "\r",
              "    let name_res = body_res.name\r",
              "    let slug_res = body_res.slug\r",
              "\r",
              "    let name_att = pm.collectionVariables.get(\"name_new\")\r",
              "    let slug_att = pm.collectionVariables.get(\"slug_new\")\r",
              "\r",
              "    pm.expect(name_att).eql(name_res)\r",
              "    pm.expect(slug_att).eql(slug_res)\r",
              "    })"
