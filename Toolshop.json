  "item": [
    {
      "name": "add categorie",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201\", function () {\r",
              "    pm.response.to.have.status(201);\r",
              "});\r",
              "\r",
              "let body_req = JSON.parse(pm.request.body.raw)\r",
              "let name_req = body_req.name\r",
              "let slug_req = body_req.slug\r",
              "\r",
              "pm.collectionVariables.set(\"name_new\",name_req)\r",
              "pm.collectionVariables.set(\"slug_new\",slug_req)\r",
              "\r",
              "\r",
              "pm.test(\"check if request body = reponse body\" , () => {\r",
              "\r",
              "    //body response \r",
              "\r",
              "    let body_res = pm.response.json()\r",
              "    let name_res = body_res.name \r",
              "    let slug_res = body_res.slug\r",
              "\r",
              "    // assertion \r",
              "    pm.expect(name_req).eql(name_res)\r",
              "    pm.expect(slug_req).eql(slug_res)\r",
              "\r",
              "    let id_categorie = body_res.id\r",
              "    pm.collectionVariables.set(\"id_categorie\",id_categorie)\r",
              "\t\tpm.collectionVariables.set(\"name_new\",name_res)\r",
              "\t\tpm.collectionVariables.set(\"slug_new\",slug_res)\r",
              "\r",
              "})"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "exec": [],
            "type": "text/javascript"
          }
        }
      ],
