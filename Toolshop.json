      "name": "get all brands",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "//get response\r",
              "let body_res=pm.response.json()\r",
              "pm.test(\"Status code is 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"verifier  si la list contient minium element\", function () {\r",
              "  \r",
              "    //je stock la liste  dans vairbale\r",
              "    let list_brands=body_res\r",
              "    let length=list_brands.length\r",
              "    //assertion\r",
              "    pm.expect(length).to.be.above(1)\r",
              "});\r",
              " pm.test(\"check if name [1] =ForgeFlex Tools\", function () {\r",
              "     //valeur attendu\r",
              "     let name_att=\"ForgeFlex Tools\"\r",
              "     //name response\r",
              "     let name_obt=body_res[1].name\r",
              "     //assertion\r",
              "     pm.expect(name_att).equal(name_obt)\r",
              "});\r",
              "\r",
              "pm.test(\"check if name  ForgeFlex Tools dans la liste\", function () {\r",
              "     //valeur attendu\r",
              "     let name_att=\"ForgeFlex Tools\"\r",
              "     let exist=checkElem(name_att,body_res)\r",
              "     //assertion\r",
              "     pm.expect(exist).to.be.true\r",
              "});\r",
              "\r",
              "\r",
              "function checkElem(name_att,list){\r",
              "    let exist =false;\r",
              "     for(let b of list){\r",
              "        if(b.name===name_att)\r",
              "        {\r",
              "            exist=true;\r",
              "            break;\r",
              "        }\r",
              "     }\r",
              "     return exist\r",
              "}\r",
              "\r",
              "\r",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
